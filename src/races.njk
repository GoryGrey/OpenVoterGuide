---
layout: base.njk
pagination:
  data: races
  size: 1
  alias: race
permalink: "/races/{{ race.id }}/"
eleventyComputed:
  title: "{{ race.office }}"
  description: "Candidates for {{ race.office }} in the Ashtabula County November 3, 2026 election."
---

<h1>{{ race.office }}</h1>
{% if race.district %}<p><strong>District:</strong> {{ race.district }}</p>{% endif %}
<p>{{ race.term_info }}</p>

<span class="verification-badge">Candidate list checked {{ race.verification_date }} against Ashtabula County BOE</span>

<h2>Candidates ({{ race.candidates.length }})</h2>
<p>Candidate backgrounds, positions, and records are editorial summaries. Sources are grouped by candidate rather than attached to individual claims; open the listed sources to check details.</p>


{% if race.candidates.length >= 2 %}
<section class="all-candidates-compare" aria-labelledby="compare-heading">
  <h2 id="compare-heading">Compare all {{ race.candidates.length }} candidates</h2>
  <p>Each candidate is shown in the same column for a quick side-by-side scan. On a small screen, scroll horizontally.</p>
  <p class="comparison-note"><strong>About ballot issue views:</strong> A candidate's stated position appears only when we have a source for it. An empty entry means this guide has not added a sourced statement; it does not mean the candidate is undecided.</p>
  <div class="comparison-table-scroll" role="region" aria-label="Side-by-side comparison of all candidates" tabindex="0">
    <table class="candidate-comparison">
      <caption class="visually-hidden">All candidates for {{ race.office }} compared by background, campaign statements, voting record, and sourced ballot issue views.</caption>
      <thead><tr><th scope="col">Compare</th>
        {% for c in race.candidates %}
        <th scope="col"><a href="#{{ c.name | slug }}">{{ c.name }}</a>
          {% if c.party %}<span class="comparison-party">{{ c.party }}</span>{% else %}<span class="comparison-party">Nonpartisan ballot</span>{% endif %}
          {% if c.incumbent %}<span class="comparison-incumbent">Incumbent</span>{% endif %}
        </th>
        {% endfor %}
      </tr></thead>
      <tbody>
        <tr><th scope="row">Background</th>{% for c in race.candidates %}<td>{{ c.background or "No background summary listed." }}</td>{% endfor %}</tr>
        <tr><th scope="row">Campaign statements</th>{% for c in race.candidates %}<td>
          {% if c.promises and c.promises.length %}<ul>{% for p in c.promises %}<li>{{ p }}</li>{% endfor %}</ul>
          {% else %}<p>No sourced campaign statements listed.</p>{% endif %}
        </td>{% endfor %}</tr>
        <tr><th scope="row">Voting record</th>{% for c in race.candidates %}<td>
          {% if c.record and c.record.length %}<ul>{% for item in c.record %}<li>{{ item }}</li>{% endfor %}</ul>
          {% else %}<p>No voting record summary listed.</p>{% endif %}
        </td>{% endfor %}</tr>
        <tr><th scope="row">Stated views on ballot issues</th>{% for c in race.candidates %}<td>
          {% if c.measure_positions and c.measure_positions.length %}
          <ul class="measure-position-list">{% for item in c.measure_positions %}<li>
            <strong>{% if item.issue_path %}<a href="{{ item.issue_path | url }}">{{ item.issue_label }}</a>{% else %}{{ item.issue_label }}{% endif %}: {{ item.position | capitalize }}</strong>
            <p>{{ item.statement }}</p>
            <small>Checked {{ item.checked_on }} · <a href="{{ item.source.url }}" rel="noopener" target="_blank">{{ item.source.label }}</a></small>
          </li>{% endfor %}</ul>
          {% else %}<p class="comparison-empty">No source-backed candidate statement on a ballot issue has been added to this guide.</p>{% endif %}
        </td>{% endfor %}</tr>
        <tr><th scope="row">Research sources</th>{% for c in race.candidates %}<td>
          {% if c.sources and c.sources.length %}<ul>{% for source in c.sources %}<li><a href="{{ source.url }}" rel="noopener" target="_blank">{{ source.label }}</a></li>{% endfor %}</ul>
          {% else %}<p>No sources listed.</p>{% endif %}
        </td>{% endfor %}</tr>
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{% for c in race.candidates %}
<div class="candidate-card" id="{{ c.name | slug }}">
  <div class="candidate-header">
    {% if c.photo_url %}
    <img src="{{ c.photo_url }}" alt="Photo of {{ c.name }}" class="candidate-photo" loading="lazy">
    {% endif %}
    <div>
      <h3>{{ c.name }}
        {% if c.party %}<span class="party-tag party-{{ c.party | first }}">{{ c.party }}</span>{% else %}<span class="party-tag">Nonpartisan ballot</span>{% endif %}
        {% if c.incumbent %}<span class="party-tag">Incumbent</span>{% endif %}
      </h3>
      {% if c.photo_credit %}<p class="photo-credit"><small>Photo: {{ c.photo_credit }}</small></p>{% endif %}
    </div>
  </div>

  <div class="worksheet-check">
    <label>
      <input type="checkbox" data-worksheet-id="race-{{ race.id }}-{{ c.name | slug }}" data-worksheet-label="{{ race.office }}: {{ c.name }}">
      Mark as my choice
    </label>
  </div>

  <h4>Background</h4>
  <p>{{ c.background }}</p>

  {% if c.promises and c.promises.length %}
  <h4>Campaign Promises & Positions</h4>
  <ul>
    {% for p in c.promises %}<li>{{ p }}</li>{% endfor %}
  </ul>
  {% endif %}

  {% if c.record and c.record.length %}
  <h4>Voting Record</h4>
  <ul>
    {% for r in c.record %}<li>{{ r }}</li>{% endfor %}
  </ul>
  {% endif %}

  <h4>Stated Views on Ballot Issues</h4>
  {% if c.measure_positions and c.measure_positions.length %}
  <ul class="measure-position-list">
    {% for item in c.measure_positions %}
    <li>
      <strong>{% if item.issue_path %}<a href="{{ item.issue_path | url }}">{{ item.issue_label }}</a>{% else %}{{ item.issue_label }}{% endif %}: {{ item.position | capitalize }}</strong>
      <p>{{ item.statement }}</p>
      <small>Checked {{ item.checked_on }} · <a href="{{ item.source.url }}" rel="noopener" target="_blank">{{ item.source.label }}</a></small>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="comparison-empty">No source-backed candidate statement on a ballot issue has been added to this guide. That does not mean the candidate is undecided.</p>
  {% endif %}

  {% if c.correlation %}
  <h4>Promise vs. Record</h4>
  <p>{{ c.correlation }}</p>
  {% endif %}

  {% if c.sources and c.sources.length %}
  <div class="source-list">
    <strong>Candidate research sources:</strong>
    <ul>
      {% for s in c.sources %}<li><a href="{{ s.url }}" rel="noopener" target="_blank">{{ s.label }}</a></li>{% endfor %}
    </ul>
  </div>
  {% endif %}
</div>
{% endfor %}

<p><a href="/OpenVoterGuide/races/">All races</a> | <a href="/OpenVoterGuide/worksheet/">My worksheet</a></p>
