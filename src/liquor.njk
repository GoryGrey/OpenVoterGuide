<article class="liquor-page">
<header class="content-page-heading"><p class="content-eyebrow">Local ballot questions</p><h1>Sunday liquor questions</h1>
<p>These local-option questions apply only to voters in the listed precinct. The wording below comes from the county’s official November 3 ballot. Check your own sample ballot to confirm whether a question appears for you.</p>
</header>

{% for item in liquor %}
<section class="measure-card" id="{{ item.id }}">
  <h2>Issue {{ item.issue_number }}: {{ item.precinct }}</h2>
  <p><strong>{{ item.establishment }}</strong> · {{ item.address }} · {{ item.business_type }} · {{ item.permit_type }} permit</p>
  <p>{{ item.plain_english }}</p>
  <h3>Official ballot wording</h3>
  <blockquote>{{ item.official_ballot_language }}</blockquote>
  <p><strong>Yes:</strong> {{ item.yes_means }}</p>
  <p><strong>No:</strong> {{ item.no_means }}</p>
  <p class="worksheet-guide-cta"><a class="primary-action" href="{{ ('/worksheet/?item=liquor-' + item.issue_number) | url }}">Review this question in the worksheet guide <span aria-hidden="true">→</span></a></p>
  <ul class="source-list">
    {% for source in item.sources %}<li><a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.label }}</a></li>{% endfor %}
  </ul>
</section>
{% endfor %}

<p><a href="{{ '/measures/' | url }}">All ballot measures →</a></p>
</article>
