---
layout: base.njk
pagination:
  data: measures
  size: 1
  alias: measure
permalink: "/measures/{{ measure.id }}/"
eleventyComputed:
  title: "{{ measure.title }} — Ohio Issue {{ measure.issue_number }}"
  description: "{{ measure.plain_english | truncate(150) }}"
---

<article class="measure-profile">
<header class="content-page-heading"><p class="content-eyebrow">November 3, 2026 · Ohio Issue {{ measure.issue_number }}</p><h1>{{ measure.title }}</h1>
<p><strong>Issue {{ measure.issue_number }}</strong></p>
</header>

<span class="verification-badge">Ballot issue sources reviewed {{ measure.verification_date }}</span>

<h2>What it proposes</h2>
<p>{{ measure.plain_english }}</p>

<div class="measure-card measure-choice-yes">
  <h3>What a YES vote means</h3>
  <p>{{ measure.yes_means }}</p>
</div>

<div class="measure-card measure-choice-no">
  <h3>What a NO vote means</h3>
  <p>{{ measure.no_means }}</p>
</div>

<div class="worksheet-check">
  <label>
    <input type="radio" name="choice-measure-{{ measure.id }}" data-worksheet-id="measure-{{ measure.id }}-yes" data-worksheet-group="measure-{{ measure.id }}" data-worksheet-label="{{ measure.title }}: YES">
    My choice: YES
  </label>
</div>
<div class="worksheet-check">
  <label>
    <input type="radio" name="choice-measure-{{ measure.id }}" data-worksheet-id="measure-{{ measure.id }}-no" data-worksheet-group="measure-{{ measure.id }}" data-worksheet-label="{{ measure.title }}: NO">
    My choice: NO
  </label>
</div>
<div class="worksheet-check"><label><input type="radio" name="choice-measure-{{ measure.id }}" data-worksheet-id="measure-{{ measure.id }}-undecided" data-worksheet-group="measure-{{ measure.id }}" data-worksheet-label="{{ measure.title }}: Undecided"> My choice: undecided</label></div>

<section class="issue-graphic" id="issue-graphic-{{ measure.id }}" aria-labelledby="issue-graphic-title-{{ measure.id }}">
  <p class="issue-graphic-brand">OpenVoterGuide · Ashtabula County, Ohio</p>
  <p class="content-eyebrow">Verified ballot issue · November 3, 2026</p>
  <h2 id="issue-graphic-title-{{ measure.id }}">Issue {{ measure.issue_number }}: {{ measure.title }}</h2>
  <p>{{ measure.plain_english }}</p>
  <div class="issue-graphic-columns"><div><h3>YES means</h3><p>{{ measure.yes_means }}</p></div><div><h3>NO means</h3><p>{{ measure.no_means }}</p></div></div>
  <p class="issue-graphic-url">openvoterguide.org</p>
</section>
<p><button type="button" onclick="(function(){document.body.classList.add('print-issue-graphic');window.print();setTimeout(()=>document.body.classList.remove('print-issue-graphic'),500)})()">Print / save this issue graphic as PDF</button></p>

<section aria-labelledby="candidate-views-heading">
  <h2 id="candidate-views-heading">What candidates have said about this issue</h2>
  <p>These entries summarize statements we could source and attribute to a specific candidate. They are not endorsements. No entry means this guide has not added a sourced statement; it does not mean a candidate is undecided or has not spoken.</p>
  <ul class="measure-position-list">
    {% for race in races %}
      {% for candidate in race.candidates %}
        {% for item in candidate.measure_positions or [] %}
          {% if item.issue_number == measure.issue_number %}
            {% set candidateAnchor = candidate.name | candidateSlug %}
            {% set candidateHref = '/candidates/' + race.id + '/' + (candidate.name | profileSlug) + '/' %}
            <li>
              <strong><a href="{{ candidateHref | url }}">{{ candidate.name }}</a> ({{ race.office }}): {{ item.position | capitalize }}</strong>
              <p>{{ item.statement }}</p>
              <small>Checked {{ item.checked_on }} · <a href="{{ item.source.url }}" rel="noopener" target="_blank">{{ item.source.label }}</a></small>
            </li>
          {% endif %}
        {% endfor %}
      {% endfor %}
    {% endfor %}
  </ul>
</section>

{% if measure.sources and measure.sources.length %}
<div class="source-list">
  <strong>Sources:</strong>
  <ul>
    {% for s in measure.sources %}<li><a href="{{ s.url }}" rel="noopener" target="_blank">{{ s.label }}</a></li>{% endfor %}
  </ul>
</div>
{% endif %}

<p><a href="{{ '/measures/' | url }}">All measures</a> | <a href="{{ '/worksheet/' | url }}">My worksheet</a></p>
</article>
