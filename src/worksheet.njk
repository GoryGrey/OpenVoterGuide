<h1>My Voting Worksheet</h1>
<p>Check boxes on race and measure pages to build your list. Everything stays in your browser. Nothing is tracked or sent to any server.</p>

<p class="worksheet-count-card"><strong><span id="worksheet-count">0</span> choices marked</strong></p>

<div id="worksheet-list"></div>

<div class="worksheet-toolbar">
  <button type="button" onclick="printWorksheet()">Print my worksheet</button>
  <button type="button" onclick="clearWorksheet()">Clear all choices</button>
</div>

<p><em>This is a private reference only, not an official ballot. Verify your choices against the official sample ballot at <a href="https://www.boe.ohio.gov/ashtabula/">boe.ohio.gov/ashtabula</a>.</em></p>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const saved = JSON.parse(localStorage.getItem('ashtabula-worksheet-2026') || '{}');
  const list = document.getElementById('worksheet-list');
  const entries = Object.entries(saved);
  if (entries.length === 0) {
    const message = document.createElement('p');
    const racesLink = document.createElement('a');
    racesLink.href = '{{ "/races/" | url }}';
    racesLink.textContent = 'races';
    const measuresLink = document.createElement('a');
    measuresLink.href = '{{ "/measures/" | url }}';
    measuresLink.textContent = 'measures';
    message.append('No choices marked yet. Browse ', racesLink, ' and ', measuresLink, ' to get started.');
    list.replaceChildren(message);
  } else {
    const choices = document.createElement('ul');
    for (const [, label] of entries) {
      const item = document.createElement('li');
      item.textContent = label;
      choices.append(item);
    }
    list.replaceChildren(choices);
  }
});
</script>
