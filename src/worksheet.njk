<h1>My Voting Worksheet</h1>
<p>Check boxes on race and measure pages to build your list. Everything stays in your browser. Nothing is tracked or sent to any server.</p>

<p class="worksheet-summary"><strong><span id="worksheet-count">0</span> choices marked</strong><span>Saved in this browser only</span></p>

<section class="worksheet-list-card" aria-label="Your marked choices"><div id="worksheet-list" aria-live="polite"></div></section>

<p>
  <button type="button" onclick="printWorksheet()">Print my worksheet <span aria-hidden="true">↗</span></button>
  <button class="secondary-button" type="button" onclick="clearWorksheet()">Clear all</button>
</p>

<p><em>This is a private reference only, not an official ballot. Verify your choices against the official sample ballot at <a href="https://www.boe.ohio.gov/ashtabula/">boe.ohio.gov/ashtabula</a>.</em></p>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const saved = JSON.parse(localStorage.getItem('ashtabula-worksheet-2026') || '{}');
  const list = document.getElementById('worksheet-list');
  const entries = Object.entries(saved);
  if (entries.length === 0) {
    list.innerHTML = '<p>No choices marked yet. Browse <a href="/OpenVoterGuide/races/">races</a> and <a href="/OpenVoterGuide/measures/">measures</a> to get started.</p>';
  } else {
    list.innerHTML = '<ul>' + entries.map(([id, label]) => `<li>${label}</li>`).join('') + '</ul>';
  }
});
</script>
