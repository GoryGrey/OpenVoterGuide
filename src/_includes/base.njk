<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Ashtabula County Voter Guide 2026</title>
  <meta name="description" content="{{ description }}">
  <meta name="ovg-base-path" content="{{ '/' | url }}">
  <link rel="canonical" href="https://gorygrey.github.io/OpenVoterGuide{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v=20261011-comparison">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header>
    <nav>
      <a href="{{ '/' | url }}" class="logo">Ashtabula County Voter Guide</a>
      <div class="nav-links">
        <a href="{{ '/races/' | url }}">Races</a>
        <a href="{{ '/voting/' | url }}">Voting info</a>
        <a href="{{ '/measures/' | url }}">Measures</a>
        <a href="{{ '/levies/' | url }}">Levies</a>
        <a href="{{ '/worksheet/' | url }}">My Worksheet</a>
        <a href="{{ '/about/' | url }}">About</a>
      </div>
      <div class="search-box">
        <input type="search" id="site-search" placeholder="Search candidates, measures..." aria-label="Search">
        <div id="search-results"></div>
      </div>
    </nav>
  </header>
  <main id="main-content">
    {{ content | safe }}
  </main>
  <footer>
    <p>Strictly nonpartisan. No endorsements. Race and ballot listings checked against county BOE lists. Candidate summaries have grouped sources; see About for the verification scope.</p>
    <p><a href="{{ '/about/' | url }}">About &amp; Sources</a> | <a href="https://www.boe.ohio.gov/ashtabula/">Ashtabula County BOE</a></p>
    <p>Open source: <a href="https://github.com/GoryGrey/OpenVoterGuide">GitHub</a> (MIT License)</p>
  </footer>
  <script>window.OVG_SEARCH_INDEX = "{{ '/search-index.json' | url }}";</script>
  <script src="{{ '/js/search.js' | url }}"></script>
  <script src="{{ '/js/worksheet.js' | url }}"></script>
</body>
</html>
