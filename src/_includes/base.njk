<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | OpenVoterGuide</title>
  <meta name="description" content="{{ description }}">
  <meta name="ovg-base-path" content="{{ '/' | url }}">
  <link rel="canonical" href="https://gorygrey.github.io/OpenVoterGuide{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="OpenVoterGuide">
  <meta property="og:url" content="https://gorygrey.github.io/OpenVoterGuide{{ page.url }}">
  <meta property="og:image" content="https://gorygrey.github.io/OpenVoterGuide/assets/brand/og-card-1200x630.png?v=20261011-logo-card1">
  <meta property="og:image:secure_url" content="https://gorygrey.github.io/OpenVoterGuide/assets/brand/og-card-1200x630.png?v=20261011-logo-card1">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="OpenVoterGuide — Know your ballot. Own your choice.">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://gorygrey.github.io/OpenVoterGuide/assets/brand/og-card-1200x630.png?v=20261011-logo-card1">
  <meta name="twitter:image:alt" content="OpenVoterGuide — Know your ballot. Own your choice.">
  <link rel="icon" href="{{ '/assets/brand/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="icon" href="{{ '/assets/brand/favicon.ico' | url }}" sizes="any">
  <link rel="apple-touch-icon" href="{{ '/assets/brand/apple-touch-icon.png' | url }}">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}?v=20261011-kofi-modal2">
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header>
    <nav>
      <a href="{{ '/' | url }}" class="logo" aria-label="OpenVoterGuide home">
        <img class="brand-wordmark" src="{{ '/assets/brand/logo-horizontal-light.svg' | url }}" alt="">
        <img class="brand-mark" src="{{ '/assets/brand/mark-light.svg' | url }}" alt="">
      </a>
      <div class="site-nav">
        <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav-links">Menu</button>
        <div class="nav-links" id="primary-nav-links">
          <a href="{{ '/races/' | url }}">Races</a>
          <a href="{{ '/voting/' | url }}">Voting info</a>
          <a href="{{ '/measures/' | url }}">Measures</a>
          <a href="{{ '/levies/' | url }}">Levies</a>
          <a href="{{ '/worksheet/' | url }}">My Worksheet</a>
          <a href="{{ '/about/' | url }}">About</a>
        </div>
      </div>
      <div class="search-box">
        <input type="search" id="site-search" placeholder="Search races or enter your address..." aria-label="Search races or enter your address" aria-controls="search-results">
        <div id="search-results" role="region" aria-label="Search results" aria-live="polite"></div>
      </div>
      <button class="header-support" type="button" aria-haspopup="dialog" aria-controls="support-dialog">❤️ Support Us</button>
    </nav>
  </header>
  <dialog class="support-dialog" id="support-dialog" aria-labelledby="support-dialog-title">
    <div class="support-dialog-header">
      <div>
        <h2 id="support-dialog-title">Support OpenVoterGuide</h2>
        <p>Contribute through Ko-fi without leaving this page.</p>
      </div>
      <button class="support-dialog-close" type="button" aria-label="Close support dialog">×</button>
    </div>
    <iframe
      id="kofiframe"
      data-src="https://ko-fi.com/openvoterguide/?hidefeed=true&amp;widget=true&amp;embed=true&amp;preview=true"
      src="about:blank"
      title="Ko-fi support panel for OpenVoterGuide"
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
    <p class="support-fallback">If the panel doesn’t load, <a href="https://ko-fi.com/openvoterguide" target="_blank" rel="noopener noreferrer">open Ko-fi directly</a>.</p>
  </dialog>
  <main id="main-content">
    {% if page.url == '/' %}
      {{ content | safe }}
    {% else %}
      <div class="page-shell">
        <div class="page-content">
          {{ content | safe }}
        </div>
      </div>
    {% endif %}
  </main>
  <footer>
    <p>Strictly nonpartisan. No endorsements. Race and ballot listings checked against county BOE lists. Candidate claims link to claim-level evidence where checked; others are marked pending. See About for verification scope.</p>
    <p><a href="{{ '/about/' | url }}">About &amp; Sources</a> | <a href="https://www.boe.ohio.gov/ashtabula/">Ashtabula County BOE</a></p>
    <p>Open source: <a href="https://github.com/GoryGrey/OpenVoterGuide">GitHub</a> (MIT License)</p>
  </footer>
  <script>
    (() => {
      const toggle = document.querySelector(".mobile-menu-toggle");
      const links = document.querySelector("#primary-nav-links");
      if (!toggle || !links) return;
      const closeMenu = () => toggle.setAttribute("aria-expanded", "false");
      toggle.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", String(toggle.getAttribute("aria-expanded") !== "true"));
      });
      links.addEventListener("click", event => {
        if (event.target.closest("a")) closeMenu();
      });
      document.addEventListener("click", event => {
        if (!event.target.closest(".site-nav")) closeMenu();
      });
      document.addEventListener("keydown", event => {
        if (event.key === "Escape") {
          closeMenu();
          toggle.focus();
        }
      });
    })();
  </script>
  <script>
    (() => {
      const trigger = document.querySelector(".header-support");
      const dialog = document.querySelector("#support-dialog");
      const closeButton = document.querySelector(".support-dialog-close");
      const frame = document.querySelector("#kofiframe");
      if (!trigger || !dialog || !closeButton || !frame) return;
      trigger.addEventListener("click", () => {
        if (frame.getAttribute("src") === "about:blank") frame.setAttribute("src", frame.dataset.src);
        dialog.showModal();
      });
      closeButton.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", event => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        frame.setAttribute("src", "about:blank");
        trigger.focus();
      });
    })();
  </script>
  <script>window.OVG_SEARCH_INDEX = "{{ '/search-index.json' | url }}"; window.OVG_DISTRICT_RACE_MAP = "{{ '/district-race-map.json' | url }}";</script>
  <script src="{{ '/js/search.js' | url }}?v=20261011-address-lookup3"></script>
  <script src="{{ '/js/worksheet.js' | url }}"></script>
</body>
</html>
